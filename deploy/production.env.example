# Copy to .env.production using scripts/prepare-production.ps1. Never commit secrets.
PUBLIC_HOST=compute.example.org
PUBLIC_URL=https://compute.example.org
SECURE_COOKIES=true
REGISTRATION_ENABLED=true
POSTGRES_PASSWORD=GENERATE_PRIVATE_RANDOM_VALUE
GITHUB_WEBHOOK_SECRET=GENERATE_PRIVATE_RANDOM_VALUE
OAUTH_SECRET_KEY=GENERATE_PRIVATE_FERNET_KEY
# Tomorrow: configure GitHub OAuth callback PUBLIC_URL/api/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
