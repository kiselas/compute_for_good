{
  "name": "computeforgood-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:i18n": "node scripts/check-i18n.mjs",
    "dev": "vite --host 127.0.0.1",
    "test:storage": "node --test scripts/test-lease-storage.mjs",
    "test:permit": "node --test scripts/test-permit-state.mjs",
    "test:session": "node --test scripts/test-session-state.mjs",
    "test:recognition": "node --test scripts/test-recognition.mjs",
    "test:growth": "node --test scripts/test-growth.mjs",
    "build": "npm run check:i18n && npm run test:storage && npm run test:permit && npm run test:session && npm run test:recognition && npm run test:growth && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.9"
  }
}
